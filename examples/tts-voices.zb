# ZapBot example: hear a phrase in every local (Piper) voice.
#
#   /test.tts.voices DO THE L!      every English voice (en_US and en_GB), one voice note each
#   /test.tts.voices                the same, saying "VOICE EXAMPLE"
#   /test.tts.vozes FAZ O L!        every Portuguese voice (pt_BR and pt_PT)
#   /test.tts.vozes                 the same, saying "AUDIO DE EXEMPLO"
#
# The ${@:-text} is all the text typed after the shortcut or, when nothing is typed, the text after ":-".
# -l forces the local engine. No -q on the /tts, on purpose: the shortcut shows each command (with the -v
# voice) and the /tts says "Generated by Piper". The voices that are not in the image are downloaded the
# first time (~60 MB each). The order of the voice notes is the order of the lines below.

/alias /test.tts.voices -desc "Says the text in every English voice (Piper), one voice note each" /batch -q
    /tts -l -v amy ${@:-VOICE EXAMPLE}
    /tts -l -v arctic ${@:-VOICE EXAMPLE}
    /tts -l -v bryce ${@:-VOICE EXAMPLE}
    /tts -l -v danny ${@:-VOICE EXAMPLE}
    /tts -l -v hfc_female ${@:-VOICE EXAMPLE}
    /tts -l -v hfc_male ${@:-VOICE EXAMPLE}
    /tts -l -v hifi_tts_92 ${@:-VOICE EXAMPLE}
    /tts -l -v joe ${@:-VOICE EXAMPLE}
    /tts -l -v john ${@:-VOICE EXAMPLE}
    /tts -l -v kathleen ${@:-VOICE EXAMPLE}
    /tts -l -v kristin ${@:-VOICE EXAMPLE}
    /tts -l -v kusal ${@:-VOICE EXAMPLE}
    /tts -l -v l2arctic ${@:-VOICE EXAMPLE}
    /tts -l -v lessac ${@:-VOICE EXAMPLE}
    /tts -l -v libritts ${@:-VOICE EXAMPLE}
    /tts -l -v libritts_r ${@:-VOICE EXAMPLE}
    /tts -l -v ljspeech ${@:-VOICE EXAMPLE}
    /tts -l -v mike ${@:-VOICE EXAMPLE}
    /tts -l -v norman ${@:-VOICE EXAMPLE}
    /tts -l -v reza_ibrahim ${@:-VOICE EXAMPLE}
    /tts -l -v ryan ${@:-VOICE EXAMPLE}
    /tts -l -v sam ${@:-VOICE EXAMPLE}
    /tts -l -v alan ${@:-VOICE EXAMPLE}
    /tts -l -v alba ${@:-VOICE EXAMPLE}
    /tts -l -v aru ${@:-VOICE EXAMPLE}
    /tts -l -v cori ${@:-VOICE EXAMPLE}
    /tts -l -v jenny_dioco ${@:-VOICE EXAMPLE}
    /tts -l -v northern_english_male ${@:-VOICE EXAMPLE}
    /tts -l -v semaine ${@:-VOICE EXAMPLE}
    /tts -l -v southern_english_female ${@:-VOICE EXAMPLE}
    /tts -l -v vctk ${@:-VOICE EXAMPLE}

/alias /test.tts.vozes -desc "Fala o texto em todas as vozes em português (Piper), uma nota de voz cada" /batch -q
    /tts -l -v cadu ${@:-AUDIO DE EXEMPLO}
    /tts -l -v edresson ${@:-AUDIO DE EXEMPLO}
    /tts -l -v faber ${@:-AUDIO DE EXEMPLO}
    /tts -l -v jeff ${@:-AUDIO DE EXEMPLO}
    /tts -l -v tugão ${@:-AUDIO DE EXEMPLO}
