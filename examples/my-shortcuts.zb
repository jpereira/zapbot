# ZapBot example: the shortcuts of the author (Jorge Pereira), as he uses them.
# @manual
#
# "@manual" in the first lines: this file is NOT loaded on the first boot. Load it (or just pick the lines
# you like and type them) with:  /alias -examples my-shortcuts   (it only shows them; /alias -yes -examples my-shortcuts loads)
# With -yes an alias that already exists is replaced by the file's; the preview says which ones.
#
# The addresses and the contacts of the originals were replaced by placeholders: edit /end.home, /end.work
# and /funny to your own. Then try /alias to list them.


# ----------------------------------------------------------------------
# Quotes (crypto, stocks, DeFi)
# ----------------------------------------------------------------------

/alias -q /bitcoio /crypto BTC
/alias -q /btc /crypto BTC
/alias -q /horadobtc /crypto -tts BTC
/alias -q /creptomoeda /crypto
/alias -q /dolar /stocks USD
/alias -q /eth /crypto ETH
/alias -q /euro /stocks EUR
/alias -q /gold /crypto XAUT
/alias -q /hype /crypto HYPE
/alias -q /mkt /stocks ${1:-MSTR}
/alias -q /mstr /stocks MSTR
/alias -q /sol /crypto SOL
/alias -q /solana /crypto SOL
/alias -q /taxas /defi -fees
/alias -q /usdt /stocks USDT
/alias -q /xaut /crypto XAUT

# ----------------------------------------------------------------------
# Banners with /ascii
# ----------------------------------------------------------------------

/alias -q /arrombado /ascii -w 60 -c # ARROMBADO!
/alias -q /bora /ascii -c # BORA!
/alias -q /fazol /ascii  FAZ O L!
/alias -q /fazolp /ascii -c # FAZ O L\nPORRA!
/alias -q /fodase /ascii -c # FODA-SE!
/alias -q /fuck /ascii -w 60 FUCK\nTHE\nPRIVACY!
/alias -q /fuckyou /ascii -w 60 -c # FUCK YOU!
/alias -q /partiu /ascii -c # PARTIU!
/alias -q /recua /ascii RECUA  - FACISTE!
/alias -q /viado /ascii -c # VIADO

# ----------------------------------------------------------------------
# Translations
# ----------------------------------------------------------------------

/alias -q /en /translate -p en $1
/alias -q /toen /translate -p en
/alias -q /toes /translate -p es
/alias -q /topt /translate -p pt
/alias -q /txt2en /translate -p en
/alias -q /txt2es /translate -p es
/alias -q /txt2pt /translate -p pt

# ----------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------

/alias -q /ideias /notes #ideias
/alias -q /n /notes
/alias -q /pt /notes #pt $1

# ----------------------------------------------------------------------
# Voice (TTS and /gpt -voice)
# ----------------------------------------------------------------------

/alias -q /gptvoz /gpt -voice
/alias -q /tovoz /gpt -voice
/alias -q /tuga /tts -q -l -v tugão $@
/alias -q /tuga.btc -desc "Speaks the text and then the Bitcoin price" /tts -q -sp 75 -l -v tugão $@ {/crypto -q BTC}
/alias -q /vf /batch -q
  /tts -q -l -v tugão $@
  /tts -q -l -v cadu $@
  /tts -q -l -v edresson $@
  /tts -q -l -v faber $@
/alias /vfazol /batch -q
  /tts -q -l -v cadu $@
  /tts -q -l -v edresson $@
  /tts -q -l -v faber $@

# ----------------------------------------------------------------------
# Debug (/debug): the levels are 1 what the bot is calling, 2 with arguments and functions, 3 everything
# ----------------------------------------------------------------------

/alias -q /dbg.off -desc "Debug off" /debug -off
/alias -q /dbg.on -desc "Debug on, level 1: what the bot is calling" /debug -on -level 1
/alias -q /dbg.on2 -desc "Debug on, level 2: with the arguments and every function" /debug -on -level 2
/alias -q /dbg.on3 -desc "Debug on, level 3: the results too (very verbose)" /debug -on -level 3

# ----------------------------------------------------------------------
# Sending (/me, /forward) and others
# ----------------------------------------------------------------------

/alias -q /end.home -desc "Address to send (example)" /me

STREET NAME, 123
Neighborhood, City - ST
ZIP: 00000-000

Google Maps: https://maps.app.goo.gl/XXXXXXXX

/alias -q /end.work -desc "Another address to send (example)" /me

STREET NAME, 123
Neighborhood, City - ST
ZIP: 00000-000

Google Maps: https://maps.app.goo.gl/XXXXXXXX

/alias -q /flood /me  -r 30 $1
/alias -q /funny /forward -q /Contact 1/ /Contact 2/ /Contact 3/
/alias -q /gptusage /gpt -usage
/alias -q /haha -desc "Foda-se comando merda" /me -r 15 AHHAhaₕₐₐₕahAHHAhaₕₐₐₕah

/alias -q /nopt /forward -q #nopt
/alias -q /nopt.add /forward -add #nopt

/alias -q /rec /sticker -ss $1
/alias -q /sts /sticker -ss
