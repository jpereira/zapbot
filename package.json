{
  "name": "zapbot",
  "version": "1.0",
  "main": "app.js",
  "license": "MIT",
  "scripts": {
    "init": "ts-node-dev -r tsconfig-paths/register --transpile-only scripts/init.ts",
    "start:dev:docker": "DOCKER_BUILDKIT=1 docker-compose --file docker/docker-compose.yml up --build --force-recreate --remove-orphans --detach",
    "start:dev": "node app.js",
    "start:prod": "node app.js",
    "start": "[ \"$NODE_ENV\" = \"production\" ] && npm run start:prod || npm run start:dev",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "colors": "^1.4.0",
    "dotenv": "^16.4.1",
    "fs-extra": "^11.4.1",
    "mathjs": "^12.3.0",
    "nodemailer": "^10.0.2",
    "patch-package": "^8.0.0",
    "puppeteer": "^25.1.0",
    "puppeteer-core": "^25.1.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1",
    "whatsapp-web.js": "v1.34.7"
  }
}
