# Node.js 24 LTS no Debian 13 (trixie), a versão estável do Debian
FROM node:24-trixie-slim

# fuso horário
ENV TZ=America/Sao_Paulo
ENV NODE_ENV=development
ENV APP_ENV=dev

# O chromium do Debian (o puppeteer não baixa o Chrome)
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    git \
    bash \
    vim \
    curl \
    wget \
    openssh-client \
    less \
    grep \
    sed \
    coreutils \
    findutils \
    procps \
    chromium \
    libnss3 \
    libfreetype6 \
    libharfbuzz0b \
    ca-certificates \
    fonts-freefont-ttf \
    html2text \
    sqlite3 \
    python3 \
    python3-venv \
    python3-pip \
    ffmpeg \
    htop \
    strace \
    lsof \
 && rm -rf /var/lib/apt/lists/*

# cria venv
RUN python3 -m venv /venv

# yt-dlp via pip, needed by "/download"
RUN /venv/bin/pip install --no-cache-dir yt-dlp

# main: em /, para o /workspace (o volume) e o /app acharem o /node_modules.
# O postinstall aplica os patches: eles e o script vêm antes do npm install
COPY package*.json ./
COPY patches ./patches
COPY scripts/aplicar-patches.js ./scripts/aplicar-patches.js
RUN npm install
RUN npm install puppeteer-core --save

# BugFix
RUN npm install github:lindionez/whatsapp-web.js#feat/fix-_serialized-id-fallback
RUN /venv/bin/python -m pip install -U yt-dlp

COPY . .
COPY --chown=node:node . /app/
#COPY --chown=node:node --chmod=755 docker/app/entrypoint.sh
RUN chown -R node:node /app

WORKDIR /app

# Misc
RUN echo "alias ls='ls --color=auto'" >> /etc/profile.d/aliases.sh && \
    echo "alias ll='ls -lah --color=auto'" >> /etc/profile.d/aliases.sh && \
    echo "alias la='ls -A --color=auto'" >> /etc/profile.d/aliases.sh

# Exponha a porta se necessário
EXPOSE 3000

# Executa script de boot
#ENTRYPOINT ["/bin/sh", "-x", "/app/docker/app/entrypoint.dev.sh"]
CMD ["/bin/bash"]
