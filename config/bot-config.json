                    "desc": "Desliga o bot: todos os comandos (inclusive os seus) são ignorados, exceto o /bot."
                },
                {
                    "opts": [
                        "admin"
                    ],
                    "values": [],
                    "desc": "Desliga o modo admin (cada comando volta a seguir o seu onlyAdmin)."
                },
                {
                    "argv": [
                        "+admin"
                    ],
                    "desc": "Liga o modo admin: só você usa comandos; os dos outros são ignorados."
                }
