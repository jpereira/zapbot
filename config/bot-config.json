{
    "_about": {
        "project": "ZapBot - Bot para WhatsApp baseado no whatsapp-web.js",
        "file": "Definição dos comandos do bot. Cada 'cmd' precisa de um handler em app.js (HANDLERS).",
        "author": "Jorge Pereira <jpereiran@gmail.com>",
        "url": "https://github.com/jpereira/zapbot",
        "copyright": "Copyright (c) 2026 Jorge Pereira",
        "license": "MIT",
        "docs": "Veja a seção 'Comandos' do README.md para o formato de cada campo."
    },
    "commands": [
        {
            "cmd": "/help",
            "aliases": [
                "/h"
            ],
            "help": "Exibe este menu de ajuda.",
            "onlyAdmin": false
        },
        {
            "cmd": "/debug",
            "usage": "/debug [OPTION]",
            "aliases": [
                "/d",
                "/dbg"
            ],
            "help": "Ajuda na depuração de problemas. O estado fica salvo (setting debug.enabled).",
            "cmd_opts": [
                {
                    "opts": [
                        "on"
                    ],
                    "values": [],
                    "desc": "Ativa o debug mode."
                },
                {
                    "opts": [
                        "off"
                    ],
                    "values": [],
                    "desc": "Desativa o debug mode."
                }
            ],
            "onlyAdmin": true
        },
        {
            "cmd": "/uptime",
            "usage": "/uptime",
            "aliases": [
                "/u"
            ],
            "help": "Exibe o tempo que o bot está rodando.",
            "onlyAdmin": true
        },
        {
            "cmd": "/ping",
            "usage": "/ping",
            "aliases": [
                "/p"
            ],
            "help": "Verificar status do bot.",
            "onlyAdmin": true
        },
        {
            "cmd": "/noffa",
            "usage": "/noffa",
            "aliases": [
                "/🌈",
                "/🏳️‍🌈"
            ],
            "help": "Da uma floreada no texto.",
            "onlyAdmin": false
        },
        {
            "cmd": "/everyone",
            "usage": "/everyone",
            "help": "Faz o reply marcando todos do grupo.",
            "onlyAdmin": true
        },
        {
            "cmd": "/monitor",
            "usage": "/monitor [OPTION]",
            "aliases": [
                "/m"
            ],
            "help": "🚧 [EM DESENVOLVIMENTO] Números a serem monitorados. Máx. definido em monitor.max (/set).",
            "disabled": true,
            "cmd_opts": [
                {
                    "opts": [
                        "list"
                    ],
                    "values": [],
                    "desc": "Lista numeros."
                },
                {
                    "opts": [
                        "logs"
                    ],
                    "values": [],
                    "desc": "Lista logs."
                },
                {
                    "opts": [
                        "add"
                    ],
                    "values": [
                        "numero"
                    ],
                    "desc": "Adiciona número para ser monitorado."
                },
                {
                    "opts": [
                        "del"
                    ],
                    "values": [
                        "numero"
                    ],
                    "desc": "Deleta numero."
                },
                {
                    "opts": [
                        "clean"
                    ],
                    "values": [],
                    "desc": "Limpa todos os números."
                }
            ],
            "onlyAdmin": true
        },
        {
            "cmd": "/crypto",
            "usage": "/crypto [OPTION]",
            "aliases": [
                "/bitcoio",
                "/creptomoeda",
                "/moedinha"
            ],
            "help": "Exibe o preço atual das cryptos ativadas.",
            "cmd_opts": [
                {
                    "opts": [
                        "list",
                        "l"
                    ],
                    "values": [],
                    "desc": "Lista as moedas suportadas (* = ativada)."
                },
                {
                    "opts": [
                        "add",
                        "a"
                    ],
                    "values": [
                        "<TOKEN>"
                    ],
                    "desc": "Ativa uma moeda suportada. Só o dono."
                },
                {
                    "opts": [
                        "del",
                        "d"
                    ],
                    "values": [
                        "<TOKEN>"
                    ],
                    "desc": "Desativa uma moeda. Só o dono."
                }
            ],
            "onlyAdmin": false
        },
        {
            "cmd": "/sticker",
            "usage": "/sticker",
            "aliases": [
                "/st"
            ],
            "help": "Cria um 'sticker' a partir de uma imagem (recorte quadrado no meio da imagem).",
            "onlyAdmin": false
        },
        {
            "cmd": "/get",
            "usage": "/get [OPTION]... URL",
            "aliases": [
                "/download"
            ],
            "help": "Caso seja válido, faz o download do video.",
            "cmd_opts": [
                {
                    "opts": [
                        "sticker",
                        "st"
                    ],
                    "values": [],
                    "desc": "Enviar como sticker (recorte quadrado no meio do vídeo)."
                },
                {
                    "opts": [
                        "audio",
                        "a"
                    ],
                    "values": [],
                    "desc": "Extrai o audio e envia no formato .mp3."
                },
                {
                    "opts": [
                        "startSec",
                        "ss"
                    ],
                    "values": [
                        "<second>"
                    ],
                    "desc": "Iniciar a partir do segundo determinado."
                },
                {
                    "opts": [
                        "endSec",
                        "es"
                    ],
                    "values": [
                        "<second>"
                    ],
                    "desc": "Cortar o video no segundo terminado."
                },
                {
                    "opts": [
                        "verbose",
                        "v"
                    ],
                    "values": [
                        ""
                    ],
                    "desc": "Exibe os parametros usados no yt-dlp/ffmpeg."
                },
                {
                    "argv": [
                        "<url>"
                    ],
                    "desc": "ex: Instagram,YouTube,X,..."
                }
            ],
            "onlyAdmin": false
        },
        {
            "cmd": "/cache",
            "usage": "/cache [OPTION]",
            "cmd_opts": [
                {
                    "opts": [
                        "clean",
                        "c"
                    ],
                    "values": [],
                    "desc": "Limpa o cache."
                },
                {
                    "opts": [
                        "force",
                        "f"
                    ],
                    "values": [],
                    "desc": "Apaga tudo."
                }
            ],
            "aliases": [
                "/c"
            ],
            "help": "Exibe espaço ocupado em ${CACHE_DIR}",
            "onlyAdmin": true
        },
        {
            "cmd": "/show",
            "usage": "/show [-N] [OPTION]",
            "aliases": [
                "/undo",
                "/s"
            ],
            "help": "Reexibe as últimas mensagens apagadas deste chat.",
            "cmd_opts": [
                {
                    "opts": [
                        "list",
                        "l"
                    ],
                    "values": [],
                    "desc": "Mostra quantas mensagens apagadas existem no cache."
                },
                {
                    "opts": [
                        "flush",
                        "f"
                    ],
                    "values": [],
                    "desc": "Remove as apagadas deste chat (no seu privado: de todos)."
                },
                {
                    "opts": [
                        "pv"
                    ],
                    "values": [],
                    "desc": "Envia no seu privado em vez de expor no chat atual."
                },
                {
                    "opts": [
                        "chat",
                        "c"
                    ],
                    "values": [
                        "<nº|nome>"
                    ],
                    "desc": "(Só no seu privado) Chat alvo: nº do /show -l ou parte do nome."
                },
                {
                    "argv": [
                        "-N"
                    ],
                    "desc": "Quantidade de mensagens (padrão 1, máx. show.max). Ex: /show -3"
                }
            ],
            "onlyAdmin": true
        },
        {
            "cmd": "/set",
            "usage": "/set [OPTION] [<chave> [<valor>]]",
            "help": "Lista, exibe e altera as configurações do bot (settings).",
            "cmd_opts": [
                {
                    "opts": [
                        "reset",
                        "r"
                    ],
                    "values": [
                        "<chave>"
                    ],
                    "desc": "Volta a chave ao valor padrão."
                },
                {
                    "argv": [
                        "<chave>"
                    ],
                    "desc": "Exibe valor, padrão e descrição da chave."
                },
                {
                    "argv": [
                        "<chave> <valor>"
                    ],
                    "desc": "Altera. Listas: itens separados por vírgula ou espaço (watch.rules: um por linha)."
                }
            ],
            "onlyAdmin": true
        },
        {
            "cmd": "/watch",
            "usage": "/watch [OPTION] [-N | <PATTERN|/REGEX/>]",
            "aliases": [
                "/w"
            ],
            "help": "Vigia as mensagens recebidas e avisa no seu privado quando alguma casar com uma regra (setting watch.rules).",
            "cmd_opts": [
                {
                    "opts": [
                        "list",
                        "l"
                    ],
                    "values": [],
                    "desc": "Lista as regras (nº, regra e ocorrências)."
                },
                {
                    "opts": [
                        "show",
                        "s"
                    ],
                    "values": [],
                    "desc": "Resumo das mensagens que casaram com a regra -N (sem -N: todas). Padrão sem opções."
                },
                {
                    "opts": [
                        "add",
                        "a"
                    ],
                    "values": [
                        "<PATTERN|/REGEX/>"
                    ],
                    "desc": "Adiciona regra: texto (sem diferenciar maiúsculas/acentos) ou /regex/flags."
                },
                {
                    "opts": [
                        "del",
                        "d"
                    ],
                    "values": [],
                    "desc": "Remove a regra -N e as ocorrências dela."
                },
                {
                    "opts": [
                        "flush",
                        "f"
                    ],
                    "values": [],
                    "desc": "Apaga as ocorrências da regra -N (sem -N: de todas). As regras são mantidas."
                },
                {
                    "argv": [
                        "-N"
                    ],
                    "desc": "Nº da regra no /watch -l. Ex: /watch -d -2, /watch -f -2"
                }
            ],
            "onlyAdmin": true
        }
    ]
}