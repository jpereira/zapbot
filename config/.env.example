COMPOSE_PROJECT_NAME="zapbot"
COMPOSE_FILE=docker/docker-compose.yml

# Número do WhatsApp que será pareado (DDI + DDD + número, sem + nem espaços).
# Ex.: PHONE_NUMBER=5521999999999@c.us
PHONE_NUMBER=

#
# E-mail (SMTP). O mesmo SMTP manda:
#   - o QR Code, quando QRCODE_EMAIL_ENABLE="true" (com "false" ele aparece nos logs);
#   - os alertas de crash, queda e reconexão (setting email.alerts, ligado por padrão),
#     sempre que HOST, USER e TO estiverem preenchidos.
# Use porta SSL implícita (465) e uma senha de app. TROQUE o código anti-phishing:
# este valor é público.
#
QRCODE_EMAIL_ENABLE="false"
QRCODE_EMAIL_SMTP_HOST="smtp.mail.yahoo.com"
QRCODE_EMAIL_SMTP_PORT="465"
QRCODE_EMAIL_SMTP_USER="mysmtpaccount@yahoo.com.br"
QRCODE_EMAIL_SMTP_PASS="mySmtpPass"
QRCODE_EMAIL_SMTP_FROM="ZapBot Email <mysmtpaccount@yahoo.com.br>"
QRCODE_EMAIL_SMTP_TO="Hare Krishina <harerkishina@gmail.com>"
QRCODE_EMAIL_SMTP_ANTIPHISHING="JaspionIsOCara"

#
# Aave V3 (/defi aave): a carteira consultada sem cadastro (só o endereço
# público 0x..., NUNCA a chave privada) e os RPCs da Ethereum e da Base. Vazios,
# valem os settings defi.aave.wallet, defi.ethereum.rpc e defi.base.rpc (os RPCs
# públicos limitam as consultas; um próprio costuma ter a chave na URL).
#
AAVE_WALLET_ADDRESS=
ETHEREUM_RPC_URL=
BASE_RPC_URL=

#
# Morpho (/defi morpho): a carteira consultada sem cadastro (só o endereço
# público 0x..., NUNCA a chave privada). Se ficar vazia, o bot usa o setting
# defi.morpho.wallet (/set defi.morpho.wallet <0x...>).
#
MORPHO_WALLET_ADDRESS=

#
# GIPHY (/giphy): crie uma chave em https://developers.giphy.com/
# Se ficar vazia, o bot usa o setting giphy.api.key (/set giphy.api.key <chave>).
#
GIPHY_API_KEY=

#
# Google Cloud Translation (/traduzir): crie a chave no console do Google Cloud
# (passo a passo em https://jpereira.github.io/zapbot/comandos/traduzir/).
# Se ficar vazia, o bot usa o setting traduzir.api.key (/set traduzir.api.key <chave>).
#
GOOGLE_TRANSLATE_API_KEY=

#
# OpenAI (/gpt). Se a chave ficar vazia, o bot usa o setting openai.api.key
# (/set openai.api.key <chave>); sem nenhuma das duas o /gpt fica desativado.
# OPENAI_MODEL vazio usa o setting openai.api.model (padrão gpt-4o-mini), que o
# /gpt -m troca pelo WhatsApp; preenchido, ele tem prioridade.
# OPENAI_TIMEOUT_MS vazio usa o setting openai.timeout.ms (padrão 60000).
#
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=
