COMPOSE_PROJECT_NAME="zapbot"
COMPOSE_FILE=docker/docker-compose.yml

# WhatsApp number to be paired (country code + area code + number, without + or spaces).
# Ex.: PHONE_NUMBER=5521999999999
PHONE_NUMBER=

#
# Where the QR Code (to pair WhatsApp) shows up: the terminal (the logs) or the email (QRCODE_EMAIL_ENABLE below)
# and, while the web interface is on, its Health page (behind its login), always: the terminal and the email give
# its direct address (<web>/qr). "true" here: only the web (with the web off, it is ignored).
QRCODE_WEB_ONLY="false"

#
# Email (SMTP). The same SMTP sends:
# - the QR Code, when QRCODE_EMAIL_ENABLE="true" (with "false" it shows in the logs);
# - the crash, outage and reconnection alerts (zapbot.email.alerts setting, on by default),
# whenever HOST, USER and TO are filled in.
# Use the implicit SSL port (465) and an app password. CHANGE the anti-phishing code:
# this value is public.
#
QRCODE_EMAIL_ENABLE="false"
# If sending the QR by email fails, shows the QR in the terminal (default "true").
QRCODE_EMAIL_FALLBACK_TERMINAL="true"
QRCODE_EMAIL_SMTP_HOST="smtp.mail.yahoo.com"
QRCODE_EMAIL_SMTP_PORT="465"
# IMAP (opcional, porta 993): habilita o /bot -flush-email (conta e limpa Sent e Trash).
# Uses the same SMTP USER and PASS.
QRCODE_EMAIL_IMAP_HOST="imap.mail.yahoo.com"
QRCODE_EMAIL_SMTP_USER="mysmtpaccount@yahoo.com.br"
QRCODE_EMAIL_SMTP_PASS="mySmtpPass"
QRCODE_EMAIL_SMTP_FROM="ZapBot Email <mysmtpaccount@yahoo.com.br>"
QRCODE_EMAIL_SMTP_TO="Hare Krishina <harerkishina@gmail.com>"
QRCODE_EMAIL_SMTP_ANTIPHISHING="JaspionIsOCara"

#
# Web interface (docs/web.md). All of them are optional.
# ZAPBOT_WEB_ENABLED: "true" or "false" turns it on or off, over the zapbot.web.enabled setting (empty: the
# setting decides; it still needs zapbot.web.login and zapbot.web.password, set with /set in WhatsApp).
# ZAPBOT_WEB_URL: the address you open it at (shown in the startup message); the zapbot.web.url setting, when
# filled in, has priority over it. In Docker, the container does not know the IP of the server: fill it in.
# ZAPBOT_WEB_HOST: the address it listens on, over the zapbot.web.host setting (the Docker image already sets
# 0.0.0.0). ZAPBOT_WEB_PORT: the port, over the zapbot.web.port setting (3200); in Docker Compose the published
# port follows it.
# ZAPBOT_WEB_BIND: Docker Compose only, where the host publishes the port (127.0.0.1 by default; 0.0.0.0 opens it
# to the network: prefer an HTTPS proxy in front).
# In Docker, the variables of this file reach the container, and so do the ones of docker/.env (which wins). But
# Compose reads ZAPBOT_WEB_BIND and ZAPBOT_WEB_PORT (to publish the port) only from docker/.env: put them there.
#
ZAPBOT_WEB_ENABLED=
ZAPBOT_WEB_URL=
# ZAPBOT_WEB_HOST=
# ZAPBOT_WEB_PORT=3200
# ZAPBOT_WEB_BIND=127.0.0.1
# ZAPBOT_WEB_TRUSTED_PROXIES=192.0.2.10

#
# Aave V3 (/defi aave): the wallet queried without a registration (only the address
# public 0x..., NEVER the private key) and the Ethereum and Base RPCs. Empty,
# the defi.aave.wallet, defi.ethereum.rpc and defi.base.rpc settings apply (the RPCs
# public ones limit queries; your own usually carries the key in the URL).
#
AAVE_WALLET_ADDRESS=
ETHEREUM_RPC_URL=
BASE_RPC_URL=

#
# Aptos (/defi liquidswap): the Aptos API key (geomi.dev), optional. Without
# it, the anonymous per-IP limit applies. Empty, the defi.aptos.apikey setting applies.
#
APTOS_API_KEY=

#
# Morpho (/defi morpho): the wallet queried without a registration (only the address
# public 0x..., NEVER the private key). If empty, the bot uses the setting
# defi.morpho.wallet (/set defi.morpho.wallet <0x...>).
#
MORPHO_WALLET_ADDRESS=

#
# GIPHY (/giphy): create a key at https://developers.giphy.com/
# If empty, the bot uses the giphy.api.key setting (/set giphy.api.key <key>).
#
GIPHY_API_KEY=

#
# OpenAI (/gpt). If the key stays empty, the bot uses the gpt.api.key setting
# (/set gpt.api.key <key>); with neither of the two /gpt stays disabled.
# An empty OPENAI_MODEL uses the gpt.api.model setting (default gpt-4o-mini), which
# /gpt -m swaps it through WhatsApp; when filled in, it has priority.
# An empty OPENAI_TIMEOUT_MS uses the gpt.timeout.ms setting (default 60000).
#
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=
