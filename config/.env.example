COMPOSE_PROJECT_NAME="zapbot"
COMPOSE_FILE=docker/docker-compose.yml

# Whatsapp Number
PHONE_NUMBER=
# Syntax example: PHONE_NUMBER=5521999984444@c.us

#
# It enables the capability to send the generated qrcode over email.
#
QRCODE_EMAIL_ENABLE="false"
QRCODE_EMAIL_SMTP_HOST="smtp.mail.yahoo.com"
QRCODE_EMAIL_SMTP_PORT="465"
QRCODE_EMAIL_SMTP_USER="mysmtpaccount@yahoo.com.br"
QRCODE_EMAIL_SMTP_PASS="mySmtpPass"
QRCODE_EMAIL_SMTP_FROM="ZapBot Email <mysmtpaccount@yahoo.com.br>"
QRCODE_EMAIL_SMTP_TO="Hare Krishina <harerkishina@gmail.com>"
QRCODE_EMAIL_SMTP_ANTIPHISHING="JaspionIsOCara"

#
# GIPHY (/gif): crie uma chave em https://developers.giphy.com/
# Se ficar vazia, o bot usa o setting gif.giphy.api.key (/set gif.giphy.api.key <chave>).
#
GIPHY_API_KEY=

#
# OpenAI (/gpt). Se a chave ficar vazia, o bot usa o setting openai.api.key
# (/set openai.api.key <chave>); sem nenhuma das duas o /gpt fica desativado.
# OPENAI_TIMEOUT_MS vazio usa o setting openai.timeout.ms (padrão 60000).
#
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=
