COMPOSE_PROJECT_NAME="zapbot"
COMPOSE_FILE=docker/docker-compose.yml

# WhatsApp number to be paired (country code + area code + number, without + or spaces).
# Ex.: PHONE_NUMBER=5521999999999
PHONE_NUMBER=

#
# Voice: /stt (speech to text, faster-whisper) and /tts (text to speech, Piper), both on this server, free.
# By default they use the best ones, which come in the Docker image (nothing to download):
#   STT_MODEL      the /stt model: large-v3, the best (others: large-v3-turbo, near it and much faster; medium,
#                  small, base, tiny...)
#   TTS_VOICE_PT   the Portuguese voice of /tts: pt_PT-tugão-medium, the tuga one (or pt_BR-faber-medium,
#                  pt_BR-cadu-medium, pt_BR-jeff-medium...)
#   TTS_VOICE_EN   the English voice of /tts: en_US-lessac-high (or en_US-ryan-high, en_GB-alan-medium...)
# They are the defaults of the stt.model, tts.voice.pt and tts.voice.en settings (a /set still changes them).
# Changed here and the bot restarted: the setting takes the new one, downloaded right at the start (the log and
# Health show it). Any other model or voice is downloaded the first time it is used (to the cache volume: it
# survives a new image).
#
STT_MODEL="large-v3"
TTS_VOICE_PT="pt_PT-tugão-medium"
TTS_VOICE_EN="en_US-lessac-high"
#
# "all": downloads EVERY model and voice in the background after the start, so none of them waits for a download
# when used (-model, /set, the /tts voices). It takes ~31 GB of disk (STT: 15 models, ~20 GB; TTS: 183 voices,
# ~11 GB) and about 2 h; the bot works meanwhile, and a download never leaves less than 5 GB free. Or a list:
# STT_MODELS="large-v3-turbo,medium". The start lists every one that exists, with ✅ on the ones that are here.
# STT_MODELS="all"
# TTS_VOICES="all"
# ZAPBOT_MODELS_PREFETCH="false"   # no list and no download at the start

#
# Web interface (docs/web.md): ON by default. On the first start, the log shows a single-use link (24 h) to
# choose the login and the password in the browser, and "First steps" walks through the rest (pairing WhatsApp,
# the email, the 2FA...):
#     🔐 ZapBot web: configure the access (login and password) in a few clicks:
#        http://192.168.1.253:3200/setup#a8F3...
# Lost the link (or the password)? /web -setup in your private chat on WhatsApp sends a new one.
# The WhatsApp QR Code is on the web too, at http://<ip>:3200/qr (Health, behind the login).
#
# ZAPBOT_WEB_ENABLED: "true" (the default) or "false"; it decides over the zapbot.web.enabled setting.
# ZAPBOT_WEB_URL: the address you open it at, the one of the links (the setup link and <web>/qr included). In
# Docker, FILL IT IN: the container does not know the IP of the server (the zapbot.web.url setting, when filled
# in, has priority over it).
# ZAPBOT_WEB_HOST: the address it listens on, over the zapbot.web.host setting (the Docker image already sets
# 0.0.0.0). ZAPBOT_WEB_PORT: the port, over the zapbot.web.port setting (3200); in Docker Compose the published
# port follows it.
# ZAPBOT_WEB_BIND: Docker Compose only, where the host publishes the port: 127.0.0.1 by default (only this
# machine); 0.0.0.0 opens it to the network (then prefer HTTPS: Tailscale serve, or a proxy with a certificate).
# In Docker, the variables of this file reach the container, and so do the ones of docker/.env (which wins). But
# Compose reads ZAPBOT_WEB_BIND and ZAPBOT_WEB_PORT (to publish the port) only from docker/.env: put them there.
#
ZAPBOT_WEB_ENABLED="true"
ZAPBOT_WEB_URL=
# ZAPBOT_WEB_HOST=
# ZAPBOT_WEB_PORT=3200
# ZAPBOT_WEB_BIND=127.0.0.1
# ZAPBOT_WEB_TRUSTED_PROXIES=192.0.2.10

#
# Where the QR Code (to pair WhatsApp) shows up: the terminal (the logs) or the email (QRCODE_EMAIL_ENABLE below)
# and, while the web interface is on, its Health page (behind its login), always: the terminal and the email give
# its direct address (<web>/qr). "true" here: only the web (with the web off, it is ignored).
QRCODE_WEB_ONLY="false"

#
# Email (SMTP and IMAP): the easiest is the web, in Settings > Email (or First steps), with buttons that fill in
# Gmail, Yahoo, iCloud and Zoho and a "Test the connection". It is saved in the database
# (/set zapbot.email.*): no file to edit.
#
# The variables below are the other way, and THEY WIN over the database: one set here overrides its setting, and
# the start says which ("Overriding db mail settings by local env: QRCODE_EMAIL_SMTP_HOST, ..."); on the web, it
# shows as 🔧 (read-only). Leave them commented to configure it on the web, or turn on "Use the ones of this page"
# there (/set zapbot.email.overrideEnv on): then the database wins and these are ignored.
#
# The same SMTP sends the QR Code (QRCODE_EMAIL_ENABLE="true"), the crash/outage/reconnection alerts
# (zapbot.email.alerts) and the backups. Port 465 (implicit SSL) or 587 (STARTTLS), and an app password. CHANGE the
# anti-phishing code: the example is public.
#
# QRCODE_EMAIL_ENABLE="false"                      # zapbot.email.qr
# QRCODE_EMAIL_FALLBACK_TERMINAL="true"            # zapbot.email.qrFallbackTerminal
# QRCODE_EMAIL_SMTP_HOST="smtp.mail.yahoo.com"     # zapbot.email.smtp.host
# QRCODE_EMAIL_SMTP_PORT="465"                     # zapbot.email.smtp.port
# QRCODE_EMAIL_IMAP_HOST="imap.mail.yahoo.com"     # zapbot.email.imap.host (optional: /bot -flush-email)
# QRCODE_EMAIL_SMTP_USER="mysmtpaccount@yahoo.com.br"                 # zapbot.email.smtp.user
# QRCODE_EMAIL_SMTP_PASS="mySmtpPass"                                 # zapbot.email.smtp.pass
# QRCODE_EMAIL_SMTP_FROM="ZapBot Email <mysmtpaccount@yahoo.com.br>"  # zapbot.email.from
# QRCODE_EMAIL_SMTP_TO="Hare Krishina <harerkishina@gmail.com>"       # zapbot.email.to
# QRCODE_EMAIL_SMTP_ANTIPHISHING="JaspionIsOCara"                     # zapbot.email.antiphishing

#
# Aave V3 (/defi aave): the wallet queried without a registration (only the address
# public 0x..., NEVER the private key) and the Ethereum and Base RPCs. Empty,
# the defi.aave.wallet, defi.ethereum.rpc and defi.base.rpc settings apply (the RPCs
# public ones limit queries; your own usually carries the key in the URL).
#
AAVE_WALLET_ADDRESS=
ETHEREUM_RPC_URL=
BASE_RPC_URL=

#
# Aptos (/defi liquidswap): the Aptos API key (geomi.dev), optional. Without
# it, the anonymous per-IP limit applies. Empty, the defi.aptos.apikey setting applies.
#
APTOS_API_KEY=

#
# Morpho (/defi morpho): the wallet queried without a registration (only the address
# public 0x..., NEVER the private key). If empty, the bot uses the setting
# defi.morpho.wallet (/set defi.morpho.wallet <0x...>).
#
MORPHO_WALLET_ADDRESS=

#
# GIPHY (/giphy): create a key at https://developers.giphy.com/
# If empty, the bot uses the giphy.api.key setting (/set giphy.api.key <key>).
#
GIPHY_API_KEY=

#
# OpenAI (/gpt). If the key stays empty, the bot uses the gpt.api.key setting
# (/set gpt.api.key <key>); with neither of the two /gpt stays disabled.
# An empty OPENAI_MODEL uses the gpt.api.model setting (default gpt-4o-mini), which
# /gpt -m swaps it through WhatsApp; when filled in, it has priority.
# An empty OPENAI_TIMEOUT_MS uses the gpt.timeout.ms setting (default 60000).
#
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=
